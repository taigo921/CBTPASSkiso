// Publish in Firebase Console before publishing the matching access-control app.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'itaigo921@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function notBlocked(uid) {
      return !exists(/databases/$(database)/documents/accessControl/$(uid))
        || get(/databases/$(database)/documents/accessControl/$(uid)).data.blocked == false;
    }
    match /accessControl/{uid} {
      // A blocked user can still receive their own stop notification.
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && request.auth.uid != uid
        && request.resource.data.keys().hasAll(['blocked', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['blocked', 'updatedAt', 'updatedBy'])
        && request.resource.data.blocked is bool
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(uid));
      allow delete: if false;
    }
    match /users/{uid} {
      allow get: if request.auth != null
        && (isAdmin() || (request.auth.uid == uid && notBlocked(uid)));
      allow list: if isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid && notBlocked(uid);
    }
  }
}
