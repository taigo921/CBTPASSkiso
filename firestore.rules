// Combined member ranking and admin-only access control. Publish before the app update.
// No CLI deployment configuration is included. Keep changes coordinated with the console.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'itaigo921@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function notBlocked(uid) {
      return !exists(/databases/$(database)/documents/accessControl/$(uid))
        || get(/databases/$(database)/documents/accessControl/$(uid)).data.blocked == false;
    }
    match /accessControl/{uid} {
      // A blocked user can still receive their own stop notification.
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && request.auth.uid != uid
        && request.resource.data.keys().hasAll(['blocked', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['blocked', 'updatedAt', 'updatedBy'])
        && request.resource.data.blocked is bool
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(uid));
      allow delete: if false;
    }
    function approvedHashes() {
      return [
        '5ec7432d9ec2f5ab41386453c80c22f421300deb5f41f372fe5fd82a8ec80fa6',
        '999ab454c352d735541ed1f1d1e610463bf22ea2f6c7069e945bc8ab91886c3d',
        '88e247da5da470b463b490a78ad57270dd8b79aabf044db7968e96776ce82f2b',
        '85949f0f4ce6cced17672c297bc7f54cae9315cb67cff3bf84911f3f29690e83',
        'd7f8d24cbb8f0e792862b1dfa301ab2e2a87b043cd7ee796799c3b0b78242363',
        '6cc5881e908692f312d0b11a1a416723d11d2905de1a3df3844554ba84c5b16e',
        'c519bfd7735cd2a3984f3646069ef194a7ba08507948fe33b54b2f0fd7657491',
        '7ff899c8b21861160777ed97f6d723b8b7cfcd525410acc4bb70a94cf779dc9e',
        '133c13f531dd83773de6eda41e4fdf244b899fb5621699ab20fbb9579c7e0853',
        'f2c3ea19bd3a9518c03037b7d0d9fd1d214737dba307c26b818364a3b6993eb4',
        '71115d3640cb152a88fcc834b36454cabf3b19a336bf0653ea83bb961b6dfeb4',
        '9211f77c8f87c25d7c17942fde5d21c9f476a489baaf2ea6ca5e6d8a76db3946',
        '53899441fa55d0708901eaa79322b4e728d97ec011dd301adf72d7cfd3867383',
        '89d7ae2a35a33b58fc5e5ee343a28b4c2eadd71c82dcba2c2651cf92d9e57dad',
        '00bb6be79512a3ed1c1f5ffa94def0690b031a07f1a97f1d46fe78fe4881239f',
        '052879fed32ec59c2707536d4b7d82ad566456f44df43371cf05d5f5383c222e'
      ];
    }
    function canonicalEmail(email) {
      let parts=email.lower().split('@');
      return parts.size()==2 && parts[1] in ['gmail.com','googlemail.com']
        ? parts[0].replace('[.]','').replace('[+].*','')+'@gmail.com' : email.lower();
    }
    function approvedMember() {
      return request.auth != null && request.auth.token.email is string
        && request.auth.token.email_verified == true && notBlocked(request.auth.uid)
        && (hashing.sha256(request.auth.token.email.lower()).toHexString().lower() in approvedHashes()
          || hashing.sha256(canonicalEmail(request.auth.token.email)).toHexString().lower() in approvedHashes());
    }
    function validLeaderboard() {
      let d=request.resource.data;
      return d.keys().hasAll(['username','avatar','answered','correct','accuracy','bestStreak','dayStreak','lastDay','game','updatedAt'])
        && d.keys().hasOnly(['username','avatar','answered','correct','accuracy','bestStreak','dayStreak','lastDay','game','updatedAt'])
        && d.username is string && d.username.size()>0 && d.username.size()<=16
        && d.avatar is string && d.avatar.size()<=120000
        && (d.avatar=='' || d.avatar.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'))
        && d.answered is int && d.answered>=0
        && d.correct is int && d.correct>=0 && d.correct<=d.answered
        && d.accuracy is number && d.accuracy>=0 && d.accuracy<=100
        && d.bestStreak is int && d.bestStreak>=0
        && d.dayStreak is int && d.dayStreak>=0
        && (d.lastDay==null || (d.lastDay is string && d.lastDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && d.game is map && d.game.keys().hasOnly(['xp']) && d.game.xp is int && d.game.xp>=0
        && d.updatedAt==request.time;
    }
    match /users/{uid} {
      allow get: if request.auth != null
        && (isAdmin() || (request.auth.uid == uid && notBlocked(uid)));
      allow list: if isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid && notBlocked(uid);
    }
    match /leaderboard/{uid} {
      allow get, list: if approvedMember();
      allow create, update: if approvedMember() && request.auth.uid==uid
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.leaderboardVisible==true
        && validLeaderboard();
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid==uid);
    }
  }
}
